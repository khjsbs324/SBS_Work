{
   "action": {
      "default_popup": "index.html"
   },
   "background": {
      "service_worker": "background.js"
   },
   "content_scripts": [ {
      "js": [ "content.js" ],
      "matches": [ "https://lilys.ai/*" ]
   }, {
      "js": [ "page-content.js" ],
      "matches": [ "http://*/*", "https://*/*", "file:///*" ],
      "run_at": "document_idle"
   } ],
   "default_locale": "en",
   "description": "__MSG_extensionDescription__",
   "icons": {
      "128": "icon_128.png",
      "16": "icon_16.png",
      "32": "icon_32.png",
      "48": "icon_48.png"
   },
   "key": "",
   "manifest_version": 3,
   "name": "__MSG_extensionName__",
   "permissions": [ "activeTab", "scripting", "storage", "tabs", "downloads" ],
   "update_url": "https://clients2.google.com/service/update2/crx",
   "version": "1.3.1",
   "web_accessible_resources": [ {
      "matches": [ "https://*.youtube.com/*", "file:///*", "http://*/*", "https://*/*" ],
      "resources": [ "icon_32.png", "icon_48.png", "simpleSpinner.gif", "right_arrow_neutral_950.svg", "lilys_ai_logo.svg", "check_alert_600.svg", "close.svg" ]
   } ]
}
