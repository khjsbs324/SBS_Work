[Node]
Start-Process "https://nodejs.org/en/download"

Test-Path "C:\Program Files\nodejs\node.exe"

$env:Path += ";C:\Program Files\nodejs"

node --version



[Git]
Start-Process "https://git-scm.com/download/win"

git --version



[npm]
npm --version

