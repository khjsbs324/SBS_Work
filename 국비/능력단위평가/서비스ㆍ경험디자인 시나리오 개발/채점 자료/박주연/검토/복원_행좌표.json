    "bbox": [
      904.11,
      2922.05,
      1043.98,
      2938.05
    ],
    "text": "카테고리별 제품 리스트"
  },
  {
    "id": "P01-R0075",
    "page": 1,
    "bbox": [
      926.11,
      2996.61,
      1021.82,
      3012.61
    ],
    "text": "제품 상세 리스트"
  },
  {
    "id": "P01-R0076",
    "page": 1,
    "bbox": [
      930.49,
      3100.03,
      1031.77,
      3116.03
    ],
    "text": "MY ROUTINE"
  },
  {
    "id": "P01-R0077",
    "page": 1,
    "bbox": [
      942.61,
      3174.59,
      1019.91,
      3190.59
    ],
