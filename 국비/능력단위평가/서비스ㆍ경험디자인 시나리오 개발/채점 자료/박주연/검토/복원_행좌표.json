    "page": 1,
    "bbox": [
      755.8,
      3100.03,
      823.44,
      3116.03
    ],
    "text": "MY SKIN"
  },
  {
    "id": "P01-R0066",
    "page": 1,
    "bbox": [
      750.92,
      3174.59,
      828.22,
      3190.59
    ],
    "text": "피부 프로필"
  },
  {
    "id": "P01-R0067",
    "page": 1,
    "bbox": [
      741.92,
      3249.14,
      837.64,
      3265.14
    ],
    "text": "피부 정보 수정"
  },
  {
    "id": "P01-R0068",
    "page": 1,
    "bbox": [
      949.99,
      2491.54,
      1012.57,
      2507.54
    ],
