  },
  {
    "id": "P01-R0069",
    "page": 1,
    "bbox": [
      926.83,
      2594.96,
      1037.26,
      2610.96
    ],
    "text": "오늘의 루틴 생성"
  },
  {
    "id": "P01-R0070",
    "page": 1,
    "bbox": [
      926.11,
      2669.52,
      1036.54,
      2685.52
    ],
