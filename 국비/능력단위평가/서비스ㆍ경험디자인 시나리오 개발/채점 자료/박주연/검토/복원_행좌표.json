    "page": 1,
    "bbox": [
      750.8,
      2491.54,
      828.1,
      2507.54
    ],
    "text": "오늘의 루틴"
  },
  {
    "id": "P01-R0059",
    "page": 1,
    "bbox": [
      734.3,
      2594.96,
      844.74,
      2610.96
    ],
    "text": "오늘의 피부 체크"
  },
  {
    "id": "P01-R0060",
    "page": 1,
    "bbox": [
      741.09,
      2669.54,
      805.38,
      2685.54
    ],
    "text": "AI 카메라"
  },
  {
