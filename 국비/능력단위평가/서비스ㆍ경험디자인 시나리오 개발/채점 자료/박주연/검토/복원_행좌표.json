    "bbox": [
      758.42,
      2744.08,
      821.0,
      2760.08
    ],
    "text": "직접 입력"
  },
  {
    "id": "P01-R0062",
    "page": 1,
    "bbox": [
      754.23,
      2838.0,
      825.3,
      2854.0
    ],
    "text": "FOR YOU"
  },
  {
    "id": "P01-R0063",
    "page": 1,
    "bbox": [
      710.66,
      2857.0,
      773.23,
      2873.0
    ],
    "text": "피부 맞춤"
  },
  {
    "id": "P01-R0064",
    "page": 1,
    "bbox": [
      717.92,
      2922.05,
      861.5,
      2938.05
    ],
    "text": "맞춤 제품 리스트 상세"
  },
  {
