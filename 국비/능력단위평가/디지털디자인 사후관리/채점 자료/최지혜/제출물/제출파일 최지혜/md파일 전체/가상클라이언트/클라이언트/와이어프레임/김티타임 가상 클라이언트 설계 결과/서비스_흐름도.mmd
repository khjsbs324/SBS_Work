flowchart TD
  %% 시작점
  START(["🏁 시작: 플로뜰리에 TEA & COFFEE 플랫폼 접속 (SCR-01)"]) --> STEP1["1. 탐색: 메인 홈 탐색 & 글라스 광택 비교 뷰어 확인"]

  %% 탐색 및 진입 분기
  STEP1 -->|글라스 티 타월 클릭| STEP2["SCR-02 Zero-Lint 글라스 티 타월 상세 (40x60cm)"]
  STEP1 -->|스팀완드 와입스 클릭| STEP3["SCR-03 바리스타 스팀완드 와입스 상세"]
  STEP1 -->|B2B 대량 도매 클릭| STEP5["SCR-05 카페 B2B 도매 발주 센터"]
  STEP1 -->|바리스타 체험팩 클릭| STEP8["SCR-08 바리스타 1장 안심 체험팩 (3,000원)"]

  %% 상세 확인 & 광택 모달
  STEP2 -->|글라스 광택 비교 확인| MODAL1["MODAL-01 글라스 닦임성 비교 뷰어"]
  MODAL1 -->|옵션 확인 복귀| STEP2
  STEP2 -->|식품위생 & 100회 세탁 검증| STEP6["SCR-06 식품 위생 & 100회 세탁 검증실"]
  STEP6 -->|발주 복귀| STEP2

  %% 카페 로고 자수 커스텀
  STEP2 -->|카페 로고 자수 추가| STEP4["SCR-04 카페 로고 자수 아틀리에"]
  STEP5 -->|로고 각인 신청| STEP4

  STEP4 --> VALID_LOGO{"로고 파일 & 텍스트<br/>유효성 검사"}
  VALID_LOGO -- "저화질/글자수 초과" --> ERROR_LOGO[["시스템: 오류 피드백 & 1:1 무료 벡터 보정 가이드"]]
  ERROR_LOGO --> STEP4

  VALID_LOGO -- "정상 파일" --> CANVAS_SYS[["시스템: Canvas 0.05초 실시간 톤온톤 자수 렌더링"]]
  CANVAS_SYS --> MODAL2["MODAL-02 카페 로고 시안 확정"]
  MODAL2 -->|시안 확정 & 담기| STEP5

  %% B2B 도매 견적 & 장바구니
  STEP5 --> CALC_DISCOUNT[["시스템: 수량별 실시간 도매 단가 연산 (최대 35% 할인)"]]
  CALC_DISCOUNT --> QUOTE_BRANCH{"사내 품의용<br/>견적서 필요 여부?"}
  
  QUOTE_BRANCH -- "PDF 견적서 다운로드" --> PDF_SYS[["시스템: 법인 직인 날인 공식 견적서 PDF 1초 출력"]]
  PDF_SYS --> LEAVE_REENTRY["사내 결재 진행 후 알림톡 링크로 결제창 재진입"]
  LEAVE_REENTRY --> STEP10

  QUOTE_BRANCH -- "즉시 발주" --> STEP9["SCR-09 카페 B2B 장바구니"]
  STEP2 -->|단품 바로구매| STEP9
  STEP3 -->|5장 세트 담기| STEP9
  STEP8 -->|3,000원 신청| STEP10["SCR-10 B2B 주문 및 사업자 결제"]

  STEP9 -->|발주서 작성 클릭| STEP10

  %% 사업자 인증 및 세금계산서 처리
  STEP10 --> SYS_TAX_AUTH[["시스템: 국세청 사업자등록번호 실시간 API 유효성 검증"]]
  SYS_TAX_AUTH --> PAY_SELECT{"결제 수단 선택"}

  PAY_SELECT -- "법인카드 / 간편결제" --> PAY_INSTANT["1초 즉시 승인"]
  PAY_SELECT -- "가상계좌 / 세금계산서" --> PAY_VIRTUAL["전자세금계산서 자동 승인 예약"]

  PAY_INSTANT --> PAY_AUTH[["시스템: PG사 실시간 결제 승인 API"]]
  PAY_VIRTUAL --> PAY_AUTH

  PAY_AUTH --> PAY_RESULT{"결제 승인 결과"}
  PAY_RESULT -- "한도초과/오류" --> PAY_ERR[["시스템: 결제 실패 안내 & 재시도"]]
  PAY_ERR --> STEP10

  PAY_RESULT -- "승인 완료" --> STEP11["SCR-11 발주 완료 & B2B 납품 확약서"]

  %% 완료 후속 처리
  STEP11 --> POST1[["시스템: 카페 로고 자수 공정 작업지시서 발송"]]
  STEP11 --> POST2[["시스템: D-Day 카페 납품 확약서 PDF 자동 발급"]]
  STEP11 --> POST3[["시스템: 국세청 전자세금계산서 자동 발행 & 알림톡 발송"]]
  POST1 --> END_NODE(["🎉 종료: D-Day 안심 카페 린넨 납품 완료"])
  POST2 --> END_NODE
  POST3 --> END_NODE

  %% 스타일 클래스 정의
  classDef startEnd fill:#2A3B30,stroke:#1A261F,stroke-width:2px,color:#FFFFFF,font-weight:bold;
  classDef action fill:#FAF7F2,stroke:#C47A5A,stroke-width:1.5px,color:#232527;
  classDef system fill:#F0FDF4,stroke:#16A34A,stroke-width:1.5px,color:#14532D;
  classDef branch fill:#FFFBEB,stroke:#D97706,stroke-width:1.5px,color:#78350F;
  classDef error fill:#FEF2F2,stroke:#EF4444,stroke-width:1.5px,stroke-dasharray: 4 4,color:#991B1B;

  class START,END_NODE startEnd;
  class STEP1,STEP2,STEP3,STEP4,STEP5,STEP8,STEP9,STEP10,STEP11,MODAL1,MODAL2,LEAVE_REENTRY,PAY_INSTANT,PAY_VIRTUAL action;
  class CANVAS_SYS,CALC_DISCOUNT,PDF_SYS,SYS_TAX_AUTH,PAY_AUTH,POST1,POST2,POST3 system;
  class VALID_LOGO,QUOTE_BRANCH,PAY_SELECT,PAY_RESULT branch;
  class ERROR_LOGO,PAY_ERR error;
