flowchart TD
  %% 시작점
  START([시작: 스테이 호스트 B2B 플랫폼 접속 P-01]) --> STEP1[/1. 탐색: 객실 번들 카탈로그 조회 P-02/]

  %% 탐색 및 분기
  STEP1 --> DECISION1{사전 검증<br>샘플 필요 여부?}
  DECISION1 -- "샘플 먼저 체험" --> SAMPLE[호스트 3종 샘플 키트 신청 P-09]
  SAMPLE --> SAMPLE_PAY[15,000원 결제 & 샘플 수령]
  SAMPLE_PAY --> COUPON[100% 환급 쿠폰 수령 후 재진입]
  COUPON --> STEP2

  DECISION1 -- "본품 즉시 발주" --> STEP2[2. 선택: 50장 스탠다드 팩 상세 P-03]

  %% 옵션 및 자수
  STEP2 --> OPTION[고리형 루프 & 겹수 옵션 선택]
  OPTION --> STEP3[3. 커스텀: 숙소 로고 업로드 P-05]
  
  STEP3 --> FILE_CHECK{로고 파일 형식<br>& 해상도 유효성?}
  FILE_CHECK -- "비지원 포맷/저화질" --> EX01[EX-01 로고 오류 안내 & 디자이너 1:1 지원]
  EX01 --> STEP3

  FILE_CHECK -- "정상 AI/PNG 파일" --> CANVAS[Canvas 실시간 자수 렌더링 M-03]
  CANVAS --> STEP4[4. 어메니티: 국/영문 리추얼 카드 무료 동봉 P-06]

  %% 견적 및 품의
  STEP4 --> STEP5[5. 견적 확인: 실시간 견적서 PDF 1초 출력 P-07 / M-04]
  STEP5 --> QUOTE_CHECK{사내 품의 결재<br>즉시 진행 여부?}
  
  QUOTE_CHECK -- "견적서 파일 저장 후 이탈" --> LEAVE[품의 결재 진행]
  LEAVE --> RE_ENTRY[알림톡 링크 / 견적서 번호로 재진입]
  RE_ENTRY --> STEP6

  QUOTE_CHECK -- "즉시 발주" --> STEP6[6. 주문/결제: B2B 장바구니 P-10]

  %% 결제 및 세무 처리
  STEP6 --> TAX_INPUT[사업자등록번호 & 담당자 이메일 입력]
  TAX_INPUT --> SYS_TAX[시스템: 국세청 사업자 유효성 실시간 검증]
  SYS_TAX --> PAY_METHOD{결제 수단 선택}
  
  PAY_METHOD -- "법인카드 / 간편결제" --> PAY_INSTANT[1초 즉시 승인]
  PAY_METHOD -- "가상계좌 / 세금계산서" --> PAY_VIRTUAL[전자세금계산서 자동 발행 예약]

  PAY_INSTANT --> STEP7[7. 완료: 발주 완료 & 출고 D-Day 확약 P-11]
  PAY_VIRTUAL --> STEP7

  %% 사후 관리 및 구독
  STEP7 --> SUBSCRIPTION[8. 사후관리: 3~6개월 정기 납품 구독 & 에코 엠블럼 수령]
  SUBSCRIPTION --> END([종료: 객실 시그니처 소창 어메니티 세팅 완료])

  %% 스타일 클래스
  classDef startEnd fill:#1A3B34,stroke:#102A24,stroke-width:2px,color:#FFFFFF;
  classDef action fill:#E8F3F1,stroke:#4A7C72,stroke-width:1.5px,color:#1A3B34;
  classDef system fill:#EBF3FA,stroke:#2B6CB0,stroke-width:1.5px,color:#1A365D;
  classDef branch fill:#FFF6ED,stroke:#D97706,stroke-width:1.5px,color:#92400E;
  classDef error fill:#FEE2E2,stroke:#EF4444,stroke-width:1.5px,stroke-dasharray: 4 4,color:#991B1B;

  class START,END startEnd;
  class STEP1,STEP2,OPTION,STEP3,STEP4,STEP5,STEP6,STEP7,SAMPLE,SAMPLE_PAY,COUPON,LEAVE,RE_ENTRY,TAX_INPUT,SUBSCRIPTION action;
  class CANVAS,SYS_TAX,PAY_INSTANT,PAY_VIRTUAL system;
  class DECISION1,FILE_CHECK,QUOTE_CHECK,PAY_METHOD branch;
  class EX01 error;
