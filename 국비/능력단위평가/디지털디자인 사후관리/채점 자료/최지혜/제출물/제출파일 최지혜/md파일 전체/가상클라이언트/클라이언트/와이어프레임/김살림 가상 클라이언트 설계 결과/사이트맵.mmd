flowchart TD
  ROOT["플로뜰리에 (Flottelier)<br>스마트 살림 & 수건 전체 교체 플랫폼"]

  %% 1차 메뉴 (Depth 1)
  ROOT --> GNB1["01. BUNDLE & SUBSCRIPTION<br>(대용량 교체 & 정기구독)"]
  ROOT --> GNB2["02. SMART CARE & PROOFS<br>(위생 & 실증 데이터)"]
  ROOT --> GNB3["03. LAUNDRY GUIDE<br>(세탁기 & 건조기 간편 관리)"]
  ROOT --> GNB4["04. HOME LINEUP<br>(미니멀 살림 풀 라인업)"]
  ROOT --> GNB5["05. TRIAL & ASSURANCE<br>(1장 체험 & 안심 보증)"]
  ROOT --> GNB6["06. ORDER & CONCIERGE<br>(주문 & 구독 관리)"]
  ROOT --> GNB7["07. EXCEPTION PAGES<br>(예외 처리)"]

  %% 2차/3차 세부 화면
  GNB1 --> SCR02["SCR-02: 10장 올체인지 데일리 팩<br>(장당 9,900원 / 대량할인)"]
  GNB1 --> B02["20장 패밀리 풀 하우스 팩<br>(최대 35% 할인)"]
  GNB1 --> SCR05["SCR-05: 정기배송 구독 센터<br>(6/12개월 교체 알림)"]

  GNB2 --> SCR03["SCR-03: 건조 & 수납 실험실<br>(3배 빠른 건조 / 1/3 슬림 수납)"]
  GNB2 --> P02["모락셀라 쉰내균 99.9% 억제 성적서"]
  GNB2 --> M02["MODAL-02: 세탁 타임라인 엠보싱 컷<br>(1회~50회 질감 확대)"]

  GNB3 --> SCR04["SCR-04: 세탁기 & 건조기 가이드<br>(삶기 없는 O/X 인포그래픽)"]
  GNB3 --> G02["건조기 저온 가이드 & 수축 안정화"]
  GNB3 --> G03["호텔식 소창 수건 3단 롤 접기"]
  GNB3 --> G04["3년 수명 후 청소용 걸레 업사이클링"]

  GNB4 --> L01["3겹 페이스타월 (표준 세안)"]
  GNB4 --> L02["4겹 바스타월 & 스포츠 롱타월"]
  GNB4 --> L03["2겹 주방 행주 & 키친 와입스"]
  GNB4 --> L04["순면 걸이용 루프(고리) 옵션"]

  GNB5 --> SCR06["SCR-06: 1장 안심 체험팩 신청관<br>(3,000원 / 100% 환급 쿠폰)"]
  GNB5 --> T02["4차 정련 완제품 무형광 안심 보증"]

  GNB6 --> SCR01["SCR-01: 메인페이지 (스마트 살림 Hero)"]
  GNB6 --> SCR07["SCR-07: 장바구니 & 간편결제 (N-Pay)"]
  GNB6 --> SCR08["SCR-08: 주문 / 구독 완료 페이지"]
  GNB6 --> SCR09["SCR-09: 마이페이지 / 구독 관리"]
  GNB6 --> SCR10["SCR-10: 검색 결과 & 살림 큐레이션"]

  GNB7 --> EX01["SCR-EX01: 검색 결과 없음 / 품절 (가정)"]
  GNB7 --> EX02["SCR-EX02: 404 Not Found (가정)"]

  %% 모달 시스템
  SCR02 -.-> M01["MODAL-01: 실시간 단가/절감액 계산기"]
  SCR03 -.-> M02
  SCR05 -.-> M03["MODAL-03: 카카오 알림톡 교체주기 설정"]

  %% 스타일링
  classDef root fill:#232527,stroke:#111,stroke-width:2px,color:#fff,font-weight:bold;
  classDef gnb fill:#7E8D7F,stroke:#556B2F,stroke-width:2px,color:#fff,font-weight:bold;
  classDef scr fill:#F4F9F8,stroke:#7E8D7F,stroke-width:1.5px,color:#232527;
  classDef modal fill:#FFF9E6,stroke:#C47A5A,stroke-width:1.5px,color:#232527;
  classDef ex fill:#FFF0F0,stroke:#D9534F,stroke-width:1.5px,color:#232527;

  class ROOT root;
  class GNB1,GNB2,GNB3,GNB4,GNB5,GNB6,GNB7 gnb;
  class SCR01,SCR02,SCR03,SCR04,SCR05,SCR06,SCR07,SCR08,SCR09,SCR10,B02,P02,G02,G03,G04,L01,L02,L03,L04,T02 scr;
  class M01,M02,M03 modal;
  class EX01,EX02 ex;
