flowchart TD
  %% 시작점
  START(["🟢 시작: 메인 접속 (SCR-01) / 검색 (SCR-10)"])

  %% 1. 탐색 및 진입
  START --> HERO["[SCR-01] 메인페이지: 3배 빠른 건조 & 1/3 수납 히어로"]
  HERO --> DECIDE_PATH{"사용자 진입 경로 선택"}

  %% 경로 분기
  DECIDE_PATH -- "10장 전면 교체" --> SCR02["[SCR-02] 10장 올체인지 데일리 팩 상세"]
  DECIDE_PATH -- "1장 먼저 체험" --> SCR06["[SCR-06] 1장 안심 체험팩 신청관 (3,000원)"]
  DECIDE_PATH -- "키워드 검색" --> SEARCH["[SCR-10] 검색 결과 & 살림 큐레이션"]

  SEARCH --> CHK_SEARCH{"검색 결과 존재 여부"}
  CHK_SEARCH -- "결과 있음" --> SCR02
  CHK_SEARCH -- "결과 없음" --> EX01["[SCR-EX01] 검색 결과 없음 / 추천 키워드"]
  EX01 --> SCR02

  %% 2. 상품 검증 및 인터랙션
  SCR02 --> INTERACT{"상세 검증 인터랙션"}
  INTERACT -- "장당 단가 계산" --> MODAL01["[MODAL-01] 실시간 단가 & 절감액 시뮬레이터"]
  INTERACT -- "건조/수납 데이터" --> SCR03["[SCR-03] 3배 빠른 건조 & 1/3 슬림 수납 실험실"]
  INTERACT -- "세탁기 관리법" --> SCR04["[SCR-04] 삶기 없는 세탁기/건조기 O/X 가이드"]

  MODAL01 --> OPTION["순면 루프(고리) 및 컬러(아이보리/세이지) 선택"]
  SCR03 --> OPTION
  SCR04 --> OPTION

  %% 3. 구매 방식 결정
  OPTION --> DECIDE_BUY{"구매 방식 결정"}

  DECIDE_BUY -- "단건 일반 구매" --> SCR07["[SCR-07] 장바구니 & 1초 간편결제 (N-Pay/카카오)"]
  DECIDE_BUY -- "정기구독 신청" --> SCR05["[SCR-05] 정기배송 구독 센터 (6/12개월 설정)"]
  
  %% 1장 체험팩 플로우
  SCR06 --> TRIAL_PAY["체험팩 3,000원 1초 결제"]
  TRIAL_PAY --> TRIAL_DONE["[SCR-08] 체험팩 완료 + 100% 환급 쿠폰 발급"]
  TRIAL_DONE -. "쿠폰 보유 후 10장 세트 재구매" .-> SCR07

  %% 정기구독 플로우
  SCR05 --> MODAL03["[MODAL-03] 카카오 알림톡 교체주기 등록"]
  MODAL03 --> SCR07

  %% 4. 결제 및 유효성 검증
  SCR07 --> CHK_PAY{"결제 정보 유효성 검증"}
  CHK_PAY -- "오류: 결제 실패/한도초과" --> ERR_PAY["결제 실패 토스트 안내 & 수단 재선택"]
  ERR_PAY --> SCR07
  CHK_PAY -- "정상 결제 승인" --> SCR08["[SCR-08] 주문 및 정기배송 신청 완료"]

  %% 5. 완료 및 사후 케어
  SCR08 --> POST_CARE["카카오 알림톡 주문서 발송 & 세탁 가이드 PDF 제공"]
  POST_CARE --> MYPAGE["[SCR-09] 마이페이지: 구독 주기 관리 & 1-Click 재주문"]
  MYPAGE --> END(["🔴 종료: 배송 완료 및 스마트 살림 시작"])

  %% 스타일 정의
  classDef startEnd fill:#232527,stroke:#111,stroke-width:2px,color:#fff,font-weight:bold;
  classDef screen fill:#F4F9F8,stroke:#7E8D7F,stroke-width:1.5px,color:#232527;
  classDef decision fill:#FEF3C7,stroke:#D97706,stroke-width:1.5px,color:#92400E,font-weight:bold;
  classDef modal fill:#FFF9E6,stroke:#C47A5A,stroke-width:1.5px,color:#232527;
  classDef error fill:#FFF0F0,stroke:#DC2626,stroke-width:1.5px,color:#991B1B;

  class START,END startEnd;
  class HERO,SCR02,SCR03,SCR04,SCR05,SCR06,SCR07,SCR08,SCR09,SEARCH,TRIAL_PAY,TRIAL_DONE,POST_CARE,OPTION screen;
  class DECIDE_PATH,CHK_SEARCH,INTERACT,DECIDE_BUY,CHK_PAY decision;
  class MODAL01,MODAL03 modal;
  class EX01,ERR_PAY error;
