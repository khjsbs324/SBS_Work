flowchart TD
    %% 메인 홈
    ROOT["HOME: 플로뜰리에 TEA & COFFEE (SCR-01)"]

    %% 1차 메뉴 그룹
    ROOT --> G_TEA["1. TEA & GLASS LINEN (카페 린넨)"]
    ROOT --> G_ATELIER["2. CAFE ATELIER (로고 자수)"]
    ROOT --> G_B2B["3. B2B WHOLESALE (도매 발주)"]
    ROOT --> G_PROOF["4. SAFETY & PROOF (식품 위생 검증)"]
    ROOT --> G_RITUAL["5. TEA RITUAL & CARE (관리 가이드)"]
    ROOT --> G_TRIAL["6. TRIAL (1장 안심 체험팩)"]
    ROOT --> G_REVIEW["7. REVIEWS (오너 후기)"]

    %% 2차 상세 페이지 연결
    G_TEA --> P_GLASS["SCR-02: Zero-Lint 글라스 티 타월 (40x60cm)"]
    G_TEA --> P_STEAM["SCR-03: 바리스타 스팀완드 와입스 5장"]
    P_GLASS -.-> M_SHINE["MODAL-01: 글라스 광택 비교 모달"]

    G_ATELIER --> P_JASU["SCR-04: 카페 로고 자수 아틀리에"]
    P_JASU -.-> M_JASU["MODAL-02: 카페 로고 시안 확정 모달"]

    G_B2B --> P_B2B_CTR["SCR-05: 카페 B2B 도매 발주 센터"]
    G_PROOF --> P_PROOF_PG["SCR-06: 식품 위생 & 100회 세탁 검증실"]
    G_RITUAL --> P_RITUAL_PG["SCR-07: 티 리추얼 & 과탄산 세척 가이드"]
    G_TRIAL --> P_TRIAL_PG["SCR-08: 바리스타 1장 안심 체험팩 (3,000원)"]
    G_REVIEW --> P_REV_PG["SCR-12: 전국 카페/티룸 오너 후기"]

    %% 주문 및 결제 여정
    P_GLASS --> P_CART["SCR-09: 카페 B2B 장바구니"]
    P_STEAM --> P_CART
    P_JASU --> P_CART
    P_B2B_CTR --> P_CART
    P_TRIAL_PG --> P_PAY["SCR-10: B2B 주문 및 사업자 결제"]
    P_CART --> P_PAY
    P_PAY --> P_COMPLETE["SCR-11: 발주 완료 & B2B 납품 확약서"]

    %% 스타일링
    classDef rootStyle fill:#2A3B30,stroke:#1A261F,stroke-width:2px,color:#FFFFFF,font-weight:bold;
    classDef groupStyle fill:#FAF7F2,stroke:#C47A5A,stroke-width:2px,color:#232527,font-weight:bold;
    classDef pageStyle fill:#FFFFFF,stroke:#8E949A,stroke-width:1.5px,color:#232527;
    classDef orderStyle fill:#EBF3FA,stroke:#2B6CB0,stroke-width:1.5px,color:#1A365D,font-weight:bold;
    classDef modalStyle fill:#FFFBEB,stroke:#D97706,stroke-width:1.5px,stroke-dasharray: 3 3,color:#78350F;

    class ROOT rootStyle;
    class G_TEA,G_ATELIER,G_B2B,G_PROOF,G_RITUAL,G_TRIAL,G_REVIEW groupStyle;
    class P_GLASS,P_STEAM,P_JASU,P_B2B_CTR,P_PROOF_PG,P_RITUAL_PG,P_TRIAL_PG,P_REV_PG pageStyle;
    class P_CART,P_PAY,P_COMPLETE orderStyle;
    class M_SHINE,M_JASU modalStyle;
