flowchart TD
  classDef main fill:#FAF7F2,stroke:#232527,stroke-width:2px;
  classDef shop fill:#EFEAE2,stroke:#C47A5A,stroke-width:2px;
  classDef modal fill:#FAF0E6,stroke:#7E8D7F,stroke-width:1px,stroke-dasharray: 5 5;
  classDef my fill:#F0F4F1,stroke:#2A2624,stroke-width:2px;

  ROOT["마미소창 (MAMI SOCHANG) 홈"] :::main

  subgraph MAIN_LAYER["01. 메인 & 안전성 (P-01 ~ P-03)"]
    P01["P-01: 메인페이지<br>(KC 인증 상단 뱃지)"] :::main
    P02["P-02: KC 성적서 원문<br>(4無 시험성적서)"] :::main
    P03["P-03: 세탁 & 건조기 가이드<br>(2겹/3겹 비교표)"] :::main
  end

  subgraph SHOP_LAYER["02. 커머스 & 체험키트 (P-04 ~ P-07)"]
    P04["P-04: 전체 베이비 카탈로그<br>(신생아/영유아/어린이집)"] :::shop
    P05["P-05: 상품 상세 페이지<br>(장당 단가 & 맘리뷰)"] :::shop
    P06["P-06: 3,000원 체험 키트<br>(원단 샘플)"] :::shop
    P07["P-07: 아기 맞춤 수량 추천기<br>(30초 큐레이션)"] :::shop
  end

  subgraph MEDIA_LAYER["03. 팝업 & 미디어 (P-08 ~ P-10)"]
    P08["P-08: 성수 팝업스토어<br>(베이비 체험관)"] :::main
    P09["P-09: 베이비 룩북<br>(출산 준비물 가이드)"] :::main
    P10["P-10: SNS 언박싱 & 리뷰<br>(아기부모 Real 후기)"] :::main
  end

  subgraph MY_LAYER["04. 마이페이지 & 재구매 (P-11 ~ P-12)"]
    P11["P-11: 장바구니 & 1초 결제<br>(N Pay 1초 간편결제)"] :::my
    P12["P-12: 마이페이지 & 재구매<br>(교체주기 알림)"] :::my
  end

  subgraph MODAL_LAYER["05. 레이어드 모달 시스템"]
    M01["M-01: 성수 팝업 사전예약 모달"] :::modal
    M02["M-02: KC 성적서 200% 원문 모달"] :::modal
    M03["M-03: 안심 교환/환불 보증 모달"] :::modal
  end

  ROOT --> P01
  P01 --> P04
  P01 --> P02
  P01 --> P08
  P04 --> P05
  P05 --> P06
  P05 --> P07
  P01 --> M02
  P05 --> M02
  P05 --> M03
  P08 --> M01
  P05 --> P11
  P11 --> P12
